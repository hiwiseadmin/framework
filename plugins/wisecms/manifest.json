    "permissions": [
        {
            "ident": "plugin.wisecms.action.category",
            "name": "CMS·栏目管理",
            "type": "route",
            "route": "/plugin/wisecms/category/*",
            "method": "*",
            "status": 1,
            "description": "栏目增删改与状态切换（含批量）"
        },
        {
            "ident": "plugin.wisecms.action.content",
            "name": "CMS·内容管理",
            "type": "route",
            "route": "/plugin/wisecms/content/*",
            "method": "*",
            "status": 1,
            "description": "内容增删改、批量操作、状态切换、版本回滚、预览令牌签发"
        },
        {
            "ident": "plugin.wisecms.action.recycle",
            "name": "CMS·回收站",
            "type": "route",
            "route": "/plugin/wisecms/recycle/*",
            "method": "*",
            "status": 1,
            "description": "回收站恢复、彻底删除与清空（高危）"
        },
        {
            "ident": "plugin.wisecms.action.model",
            "name": "CMS·内容模型",
            "type": "route",
            "route": "/plugin/wisecms/model/*",
            "method": "*",
            "status": 1,
            "description": "内容模型增删改、导入导出（涉及 DDL）"
        },
        {
            "ident": "plugin.wisecms.action.modelField",
            "name": "CMS·模型字段",
            "type": "route",
            "route": "/plugin/wisecms/modelField/*",
            "method": "*",
            "status": 1,
            "description": "动态字段增删改（涉及 DDL）"
        },
        {
            "ident": "plugin.wisecms.action.tag",
            "name": "CMS·标签管理",
            "type": "route",
            "route": "/plugin/wisecms/tag/*",
            "method": "*",
            "status": 1,
            "description": "标签增删改"
        },
        {
            "ident": "plugin.wisecms.action.page",
            "name": "CMS·单页管理",
            "type": "route",
            "route": "/plugin/wisecms/page/*",
            "method": "*",
            "status": 1,
            "description": "单页增删改"
        },
        {
            "ident": "plugin.wisecms.action.template",
            "name": "CMS·内容模板",
            "type": "route",
            "route": "/plugin/wisecms/template/*",
            "method": "*",
            "status": 1,
            "description": "内容模板增删改与默认模板安装"
        },
        {
            "ident": "plugin.wisecms.action.searchLog",
            "name": "CMS·搜索日志",
            "type": "route",
            "route": "/plugin/wisecms/searchLog/*",
            "method": "*",
            "status": 1,
            "description": "搜索日志与热搜词查看（只读）"
        },
        {
            "ident": "plugin.wisecms.action.comment",
            "name": "CMS·评论管理",
            "type": "route",
            "route": "/plugin/wisecms/comment/*",
            "method": "*",
            "status": 1,
            "description": "评论审核、驳回与删除"
        },
        {
            "ident": "plugin.wisecms.action.friendLink",
            "name": "CMS·友情链接",
            "type": "route",
            "route": "/plugin/wisecms/friendLink/*",
            "method": "*",
            "status": 1,
            "description": "友链增删改、排序与上下架"
        },
        {
            "ident": "plugin.wisecms.action.urlRule",
            "name": "CMS·URL规则",
            "type": "route",
            "route": "/plugin/wisecms/urlRule/*",
            "method": "*",
            "status": 1,
            "description": "伪静态规则增删改与全站别名重建"
        },
        {
            "ident": "plugin.wisecms.action.generation",
            "name": "CMS·AI生成",
            "type": "route",
            "route": "/plugin/wisecms/generation/*",
            "method": "*",
            "status": 1,
            "description": "AI 内容生成工作台、自然语言与批量生成、任务取消"
        },
        {
            "ident": "plugin.wisecms.action.schedule",
            "name": "CMS·定时排期",
            "type": "route",
            "route": "/plugin/wisecms/schedule/*",
            "method": "*",
            "status": 1,
            "description": "发布日历、批量排期与推荐时段"
        },
        {
            "ident": "plugin.wisecms.action.workflow",
            "name": "CMS·内容工作流",
            "type": "route",
            "route": "/plugin/wisecms/workflow/*",
            "method": "*",
            "status": 1,
            "description": "内容状态流转与可用动作查询"
        },
        {
            "ident": "plugin.wisecms.action.site",
            "name": "CMS·多站点",
            "type": "route",
            "route": "/plugin/wisecms/site/*",
            "method": "*",
            "status": 1,
            "description": "站点增删改（高危：删除会影响全站数据隔离）"
        },
        {
            "ident": "plugin.wisecms.action.site.context",
            "name": "CMS·切换站点上下文",
            "type": "route",
            "route": "/plugin/wisecms/site/switch",
            "method": "*",
            "status": 1,
            "description": "后台站点选择器：只切换会话内的当前站点，不修改任何业务数据（可单独授予内容编辑者，无需授予「多站点」管理权）"
        },
        {
            "ident": "plugin.wisecms.action.site.option",
            "name": "CMS·站点下拉数据",
            "type": "route",
            "route": "/plugin/wisecms/site/options",
            "method": "*",
            "status": 1,
            "description": "后台站点选择器数据源（启用站点列表 + 当前站点）"
        },
        {
            "ident": "plugin.wisecms.action.ad",
            "name": "CMS·广告管理",
            "type": "route",
            "route": "/plugin/wisecms/ad/*",
            "method": "*",
            "status": 1,
            "description": "广告位增删改"
        },
        {
            "ident": "plugin.wisecms.action.spider",
            "name": "CMS·内容采集",
            "type": "route",
            "route": "/plugin/wisecms/spider/*",
            "method": "*",
            "status": 1,
            "description": "采集任务增删改与执行（会发起外部请求）"
        },
        {
            "ident": "plugin.wisecms.action.seo",
            "name": "CMS·SEO 总览",
            "type": "route",
            "route": "/plugin/wisecms/seo/*",
            "method": "*",
            "status": 1,
            "description": "SEO 健康分 / 内容审查 / 搜索引擎推送（推送会发起外部请求）"
        },
        {
            "ident": "plugin.wisecms.action.internalLink",
            "name": "CMS·内链管理",
            "type": "route",
            "route": "/plugin/wisecms/internalLink/*",
            "method": "*",
            "status": 1,
            "description": "内链规则的列表 / 新增 / 删除 / 从内容库重建"
        },
        {
            "ident": "plugin.wisecms.action.webhook",
            "name": "CMS·Webhook",
            "type": "route",
            "route": "/plugin/wisecms/webhook/*",
            "method": "*",
            "status": 1,
            "description": "Webhook 订阅注册与删除（含密钥）"
        },
        {
            "ident": "plugin.wisecms.action.newsletter",
            "name": "CMS·邮件订阅",
            "type": "route",
            "route": "/plugin/wisecms/newsletter/*",
            "method": "*",
            "status": 1,
            "description": "订阅者列表与删除（个人信息）"
        },
        {
            "ident": "plugin.wisecms.action.redirect",
            "name": "CMS·重定向",
            "type": "route",
            "route": "/plugin/wisecms/redirect/*",
            "method": "*",
            "status": 1,
            "description": "301/302 规则、CSV 导入与死链检测（会发起外部请求）"
        },
        {
            "ident": "plugin.wisecms.action.dashboard",
            "name": "CMS·数据看板",
            "type": "route",
            "route": "/plugin/wisecms/dashboard/*",
            "method": "*",
            "status": 1,
            "description": "内容统计、趋势与 TOP 排行"
        },
        {
            "ident": "plugin.wisecms.action.system",
            "name": "CMS·系统工具",
            "type": "route",
            "route": "/plugin/wisecms/system/*",
            "method": "*",
            "status": 1,
            "description": "插件级维护：刷新 CMS 缓存（只清本插件缓存家族，不动数据）"
        }
    ],
    "config": {

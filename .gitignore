# Build / Dist
# ========================
/public/build/
/public/dist/
/node_modules/
# 编辑器闭环验证（npm run verify:editor）产出的截图与 Chrome 临时 profile
/.verify-out/

# ========================
# Static / Third-party
# ========================
# 插件资产发布目录（AssetManager 复制）
/public/statics/plugins/
# 会员主题资产发布目录（member 插件 manifest.publish 声明）
/public/statics/member/

# ========================
# 运行期用户上传（不入库，保留目录）
# ---------------------------------------------------------------
# uploads 下是使用方运行期产生的文件，属于部署环境数据，不能进仓库：
# 会随框架 dist 分发、被误当成示例资源，且体积无上限增长。
# ========================
/public/uploads/*
!/public/uploads/.gitkeep

# ========================
# 本地环境文件（不随仓库分发）
# ---------------------------------------------------------------
# 锚定到 src 根：`.user.ini` 是 PHP per-directory 配置（部署方按需创建），
# `.travis.yml` 为历史 CI 残留。
# ========================
/.user.ini
/.travis.yml

